{
  "title": "CarePulse — SLO Dashboard",
  "uid": "carepulse-slo",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Search Indexer — Kafka Consumer Lag",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "kafka_consumer_lag_sum{group=\"search-indexer\"}",
        "legendFormat": "lag (messages)"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null,  "color": "green" },
              { "value": 1000,  "color": "yellow" },
              { "value": 10000, "color": "red" }
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Search Indexer — Bulk Flush Rate (docs/s)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 4 },
      "targets": [{
        "expr": "rate(search_indexer_docs_flushed_total[1m])",
        "legendFormat": "docs/s"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3,
      "title": "Search Indexer — Flush Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 4 },
      "targets": [{
        "expr": "rate(search_indexer_flush_errors_total[1m])",
        "legendFormat": "errors/s"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.01, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "API p99 / p50 Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_ms_bucket[5m]))",
          "legendFormat": "p99 {{service}}"
        },
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_ms_bucket[5m]))",
          "legendFormat": "p50 {{service}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 5,
      "title": "Error Budget Remaining (30d window, 99.9% SLO)",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 6 },
      "targets": [{
        "expr": "1 - (increase(http_requests_total{status=~\"5..\"}[30d]) / increase(http_requests_total[30d]))",
        "legendFormat": "error budget"
      }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.95, "color": "yellow" },
              { "value": 0.999, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Postgres Replication Lag",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 6 },
      "targets": [{
        "expr": "pg_replication_lag",
        "legendFormat": "replication lag (s)"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "title": "OpenSearch — Index Doc Count",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [{
        "expr": "opensearch_index_docs_count{index=~\"carepack-.*\"}",
        "legendFormat": "{{index}}"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 8,
      "title": "Alert Pipeline — Risk Events Scored (rate)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 8, "w": 18, "h": 4 },
      "targets": [
        {
          "expr": "rate(kafka_topic_messages_in_total{topic=\"domain.risk.scored\"}[1m])",
          "legendFormat": "scored/s"
        },
        {
          "expr": "rate(kafka_topic_messages_in_total{topic=\"domain.telemetry.ingested\"}[1m])",
          "legendFormat": "ingested/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 100,
      "title": "Error-budget burn — fast (1h window)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "description": "Ratio of error rate to allowed budget. >1 = burning faster than budget. >14.4 fires a page.",
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{service=\"gateway-graphql\",code=~\"5..\"}[1h])) / sum(rate(http_requests_total{service=\"gateway-graphql\"}[1h]))) / (1 - 0.999)",
          "legendFormat": "gateway-graphql"
        },
        {
          "expr": "(sum(rate(http_requests_total{service=\"patient-service\",code=~\"5..\"}[1h])) / sum(rate(http_requests_total{service=\"patient-service\"}[1h]))) / (1 - 0.999)",
          "legendFormat": "patient-service"
        },
        {
          "expr": "(sum(rate(http_requests_total{service=\"telemetry-ingest\",code=~\"5..\"}[1h])) / sum(rate(http_requests_total{service=\"telemetry-ingest\"}[1h]))) / (1 - 0.9995)",
          "legendFormat": "telemetry-ingest"
        },
        {
          "expr": "(sum(rate(alerts_created_total{service=\"workflow-alerts\",status!=\"ok\"}[1h])) / sum(rate(alerts_created_total{service=\"workflow-alerts\"}[1h]))) / (1 - 0.9995)",
          "legendFormat": "workflow-alerts (creation)"
        },
        {
          "expr": "(sum(rate(risk_scored_total{service=\"risk-engine\",status!=\"ok\"}[1h])) / sum(rate(risk_scored_total{service=\"risk-engine\"}[1h]))) / (1 - 0.999)",
          "legendFormat": "risk-engine"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          }
        }
      }
    },
    {
      "id": 101,
      "title": "Remaining error budget (30d)",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "description": "1 - (errors / allowed_errors over 30d). 0 = budget exhausted; feature freeze.",
      "targets": [
        {
          "expr": "1 - ((sum(increase(http_requests_total{service=\"gateway-graphql\",code=~\"5..\"}[30d])) / sum(increase(http_requests_total{service=\"gateway-graphql\"}[30d]))) / (1 - 0.999))",
          "legendFormat": "gateway-graphql"
        },
        {
          "expr": "1 - ((sum(increase(http_requests_total{service=\"patient-service\",code=~\"5..\"}[30d])) / sum(increase(http_requests_total{service=\"patient-service\"}[30d]))) / (1 - 0.999))",
          "legendFormat": "patient-service"
        },
        {
          "expr": "1 - ((sum(increase(alerts_created_total{service=\"workflow-alerts\",status!=\"ok\"}[30d])) / sum(increase(alerts_created_total{service=\"workflow-alerts\"}[30d]))) / (1 - 0.9995))",
          "legendFormat": "workflow-alerts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "yellow", "value": 0.25 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "id": 102,
      "title": "alert-projector consumer lag (workflow-alerts.dynamo_projection_lag SLI)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 6 },
      "description": "Sustained > 100 → page. Lag here = NEWS2 escalation Lambda fires late.",
      "targets": [
        {
          "expr": "max(kafka_consumer_records_lag_max{service=\"workflow-alerts\",topic=\"cdc.outbox.events\",group=\"alert-projector\"})",
          "legendFormat": "max lag (msgs)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    }
  ]
}
